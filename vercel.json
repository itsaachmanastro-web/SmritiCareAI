{
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/ai/chat"
    },
    {
      "source": "/api/status",
      "destination": "/api/ai/status"
    },
    {
      "source": "/api/test",
      "destination": "/api/ai/test"
    },
    {
      "source": "/api/location/maps-test",
      "destination": "/api/location/maps-config?action=test"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
