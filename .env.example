# ==============================================================================
# SmritiCare – Environment Configuration Template
# Copy this file to .env and replace the placeholder values with your real keys.
# DO NOT COMMIT YOUR .env FILE TO VERSION CONTROL.
# ==============================================================================

# --- Supabase Cloud Backend (Optional) ---
# When provided, the app replicates offline IndexedDB data to your Supabase PostgreSQL database.
# When left blank, SmritiCare operates 100% offline-first using browser Dexie IndexedDB.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Google Gemini AI API (Required for Real LLM Assistant & Voice) ---
# Obtain a free key from https://aistudio.google.com/app/apikey
# Kept strictly server-side in Vite middleware / backend proxy (never exposed in client bundle).
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# --- Custom Backend API Origin (Optional) ---
# If deploying frontend (e.g. Vercel) separately from backend middleware (e.g. Render/Node):
# Leave blank when frontend and backend share the same origin or reverse proxy.
VITE_API_BASE_URL=
